FROM node:22
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY server/package.json ./server/package.json
COPY ./scripts/*-static-server.sh ./scripts/
COPY client ./client/
COPY static ./static/
COPY staticServer ./staticServer/
COPY types ./types/
COPY smshTypes ./smshTypes/
RUN chmod +x ./scripts/*-static-server.sh
RUN ./scripts/build-static-server.sh
EXPOSE 5890
CMD ["bash", "./scripts/run-static-server.sh"]
